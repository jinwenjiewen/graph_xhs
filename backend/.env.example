# 生文模型：独立填写 URL、模型名和 API Key；请勿提交真实 Key。
VOLCENGINE_API_KEY=
VOLCENGINE_MODEL=doubao-seed-2-1-pro-260915
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 文生图模型：独立填写 URL、模型名和 API Key，不会复用生文模型配置。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_SIZE=2K
ARK_IMAGE_WATERMARK=false

# PostgreSQL（按本地环境修改）。工作流检查点会通过 psycopg_pool 写入此数据库。
DATABASE_URL=postgresql://postgres:root@localhost:5432/aicontent
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
